{
  "name": "idcu_business_heartbeat",
  "category": "business",
  "version": "1.0.0",
  "description": "Heartbeat module for IDCU Agent",
  "author": "IDCU Team",
  "license": "MIT",
  "dependencies": ["idcu-common", "idcu-config", "idcu-log", "idcu-business-log", "idcu-business-core-module"],
  "priority": "high",
  "type": "builtin",
  "config_schema": {
    "interval_ms": { "type": "integer", "default": 5000 }
  },
  "build": {
    "language": "C",
    "standard": "99",
    "type": "static",
    "sources": ["src/*.c"],
    "includes": ["include", "../../core/module-system/include", "../../core/micro-kernel/include"],
    "link_libraries": ["idcu-common", "idcu-config", "idcu-log", "idcu-business-log", "idcu-business-core-module"],
    "platform_deps": {
      "win32": [],
      "unix": []
    }
  }
}
