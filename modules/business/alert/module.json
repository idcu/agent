{
  "name": "idcu_business_alert",
  "category": "business",
  "version": "2.0.0",
  "description": "Alert management and notification module for IDCU Agent",
  "author": "IDCU Team",
  "license": "MIT",
  "dependencies": ["idcu-common", "idcu-config", "idcu-alert", "idcu-business-log", "idcu-business-core-module"],
  "priority": "normal",
  "type": "builtin",
  "config_schema": {
    "enabled": { "type": "boolean", "default": true },
    "notification_url": { "type": "string", "default": "http://localhost:8080/alert" },
    "retry_count": { "type": "integer", "default": 3 }
  },
  "build": {
    "language": "C",
    "standard": "99",
    "type": "static",
    "sources": ["src/*.c"],
    "includes": ["include", "../../core/module-system/include", "../../core/micro-kernel/include"],
    "link_libraries": ["idcu-common", "idcu-config", "idcu-alert", "idcu-business-log", "idcu-business-core-module"],
    "platform_deps": {
      "win32": [],
      "unix": []
    }
  }
}
