{
  "name": "idcu_core_sdk",
  "category": "core",
  "version": "1.0.0",
  "description": "SDK module providing simplified development interfaces and utility wrappers",
  "author": "IDCU Team",
  "license": "MIT",
  "dependencies": ["idcu-common", "idcu-log", "idcu-core-module-system", "idcu-core-scheduler"],
