{
  "name": "idcu_core_micro_kernel",
  "category": "core",
  "version": "1.0.0",
  "description": "Micro kernel module managing coroutine scheduler, message bus, sandbox, and module lifecycle",
  "author": "IDCU Team",
  "license": "MIT",
  "dependencies": ["idcu-common", "idcu-log", "idcu-core-module-system", "idcu-core-scheduler"],
  "priority": "high",
  "type": "builtin",
  "config_schema": {},
  "build": {
    "language": "C",
    "standard": "99",
    "type": "static",
    "sources": ["src/*.c"],
    "includes": ["include", "../scheduler/include", "../module-system/include"],
    "link_libraries": ["idcu-common", "idcu-log", "idcu-core-module-system", "idcu-core-scheduler"],
    "platform_deps": {
      "win32": [],
      "unix": []
    }
  }
}
