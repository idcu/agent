#include "../include/micro_kernel.h"
#include "../../module-system/include/module_registry.h"
#include "../../module-system/include/module_def.h"
#include "idcu/log/log.h"
#include <stdio.h>
#include <string.h>

static idcu_MicroKernel g_kernel;

idcu_MicroKernel* idcu_get_kernel(void)
{
    return &g_kernel;
}

static int test_module1_init_called = 0;
static int test_module1_run_called = 0;
static int test_module1_stop_called = 0;

static int test_module1_init(void) {
    test_module1_init_called = 1;
    return IDCU_ERR_OK;
}

static int test_module1_run(void) {
    test_module1_run_called = 1;
    return IDCU_ERR_OK;
}

static int test_module1_stop(void) {
    test_module1_stop_called = 1;
    return IDCU_ERR_OK;
}

static int test_module2_init_called = 0;
static int test_module2_run_called = 0;
static int test_module2_stop_called = 0;

static int test_module2_init(void) {
    test_module2_init_called = 1;
    return IDCU_ERR_OK;
}

static int test_module2_run(void) {
    test_module2_run_called = 1;
    return IDCU_ERR_OK;
}

static int test_module2_stop(void) {
    test_module2_stop_called = 1;
    return IDCU_ERR_OK;
}

static const idcu_ModuleInterface g_test_iface1 = {
    .name = "test_module1",
    .dependencies = NULL,
    .dependency_count = 0,
    .init = test_module1_init,
    .run = test_module1_run,
    .stop = test_module1_stop
};

static const idcu_ModuleInterface g_test_iface2 = {
    .name = "test_module2",
    .dependencies = NULL,
    .dependency_count = 0,
    .init = test_module2_init,
    .run = test_module2_run,
    .stop = test_module2_stop
};

static void reset_test_flags(void) {
    test_module1_init_called = 0;
    test_module1_run_called = 0;
    test_module1_stop_called = 0;
    test_module2_init_called = 0;
    test_module2_run_called = 0;
    test_module2_stop_called = 0;
}

static void test_kernel_init(void) {
    idcu_MicroKernel k;
    
    idcu_kernel_init(&k);
    
    if (k.should_exit != 0) {
        printf("test_kernel_init: FAIL - should_exit should be 0 after init\n");
        return;
    }
    if (k.tracked_cnt != 0) {
        printf("test_kernel_init: FAIL - tracked_cnt should be 0 after init\n");
        return;
    }
    
    printf("test_kernel_init: PASS\n");
}

static void test_kernel_stop(void) {
    idcu_MicroKernel k;
    
    idcu_kernel_init(&k);
    
    k.tracked_cnt = 2;
    k.tracked_modules[0].iface = &g_test_iface1;
    k.tracked_modules[0].state = IDCU_MOD_STATE_RUNNING;
    k.tracked_modules[1].iface = &g_test_iface2;
    k.tracked_modules[1].state = IDCU_MOD_STATE_RUNNING;
    
    reset_test_flags();
    idcu_kernel_stop(&k);
    
    if (k.tracked_modules[0].state != IDCU_MOD_STATE_STOPPED) {
        printf("test_kernel_stop: FAIL - Module 0 should be stopped\n");
        return;
    }
    if (k.tracked_modules[1].state != IDCU_MOD_STATE_STOPPED) {
        printf("test_kernel_stop: FAIL - Module 1 should be stopped\n");
        return;
    }
    
    printf("test_kernel_stop: PASS\n");
}

static void test_kernel_set_signal_handler(void) {
    idcu_MicroKernel k;
    
    idcu_kernel_init(&k);
    idcu_kernel_set_signal_handler(&k);
    
    printf("test_kernel_set_signal_handler: PASS\n");
}

static void test_kernel_start_stop_lifecycle(void) {
    idcu_MicroKernel k;
    idcu_ModuleRegistry reg;
    
    idcu_module_registry_init(&reg);
    
    reset_test_flags();
    idcu_module_registry_register(&reg, &g_test_iface1, IDCU_MOD_PRIO_NORMAL);
    idcu_module_registry_register(&reg, &g_test_iface2, IDCU_MOD_PRIO_NORMAL);
    
    idcu_kernel_init(&k);
    
    k.tracked_cnt = 2;
    k.tracked_modules[0].iface = &g_test_iface1;
    k.tracked_modules[0].state = IDCU_MOD_STATE_RUNNING;
    k.tracked_modules[1].iface = &g_test_iface2;
    k.tracked_modules[1].state = IDCU_MOD_STATE_RUNNING;
    
    idcu_kernel_stop(&k);
    
    idcu_module_registry_destroy(&reg);
    
    printf("test_kernel_start_stop_lifecycle: PASS\n");
}

static void test_kernel_should_exit_flag(void) {
    idcu_MicroKernel k;
    
    idcu_kernel_init(&k);
    
    if (k.should_exit != 0) {
        printf("test_kernel_should_exit_flag: FAIL - should_exit should be 0 initially\n");
        return;
    }
    
    k.should_exit = 1;
    if (k.should_exit != 1) {
        printf("test_kernel_should_exit_flag: FAIL - should_exit should be settable to 1\n");
        return;
    }
    
    printf("test_kernel_should_exit_flag: PASS\n");
}

static void test_kernel_tracked_modules(void) {
    idcu_MicroKernel k;
    
    idcu_kernel_init(&k);
    
    k.tracked_cnt = 2;
    k.tracked_modules[0].iface = &g_test_iface1;
    k.tracked_modules[0].state = IDCU_MOD_STATE_RUNNING;
    k.tracked_modules[1].iface = &g_test_iface2;
    k.tracked_modules[1].state = IDCU_MOD_STATE_RUNNING;
    
    if (k.tracked_cnt != 2) {
        printf("test_kernel_tracked_modules: FAIL - tracked_cnt should be 2\n");
        return;
    }
    if (k.tracked_modules[0].iface == NULL) {
        printf("test_kernel_tracked_modules: FAIL - Module 0 interface should not be NULL\n");
        return;
    }
    if (k.tracked_modules[1].iface == NULL) {
        printf("test_kernel_tracked_modules: FAIL - Module 1 interface should not be NULL\n");
        return;
    }
    if (k.tracked_modules[0].state != IDCU_MOD_STATE_RUNNING) {
        printf("test_kernel_tracked_modules: FAIL - Module 0 should be running\n");
        return;
    }
    if (k.tracked_modules[1].state != IDCU_MOD_STATE_RUNNING) {
        printf("test_kernel_tracked_modules: FAIL - Module 1 should be running\n");
        return;
    }
    
    printf("test_kernel_tracked_modules: PASS\n");
}

int main(void) {
    idcu_log_init(NULL, IDCU_LOG_INFO);
    
    printf("=== Micro Kernel Tests ===\n");
    
    test_kernel_init();
    test_kernel_stop();
    test_kernel_set_signal_handler();
    test_kernel_start_stop_lifecycle();
    test_kernel_should_exit_flag();
    test_kernel_tracked_modules();
    
    printf("=== All Tests Completed ===\n");
    
    return 0;
}
