{
  "name": "idcu-msgbus",
  "category": "library",
  "version": "1.0.0",
  "description": "IDCU 消息总线库，提供多优先级消息传递和零拷贝传输功能",
  "author": "IDCU Team",
  "license": "MIT",
  "dependencies": ["idcu-common", "idcu-coroutine", "idcu-log"],
  "priority": "high",
  "type": "library",
  "build": {
    "language": "C",
    "standard": "99",
    "type": "static",
    "sources": ["src/idcu/msgbus/*.c"],
    "includes": ["include"],
    "link_libraries": ["idcu-common", "idcu-coroutine", "idcu-log"],
    "platform_deps": {
      "win32": [],
      "unix": ["pthread"]
    }
  }
}
