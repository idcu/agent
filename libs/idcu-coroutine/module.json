{
  "name": "idcu-coroutine",
  "category": "library",
  "version": "1.0.0",
  "description": "IDCU 协程调度器库，提供轻量级协程调度功能",
  "author": "IDCU Team",
  "license": "MIT",
  "dependencies": ["idcu-common", "idcu-log"],
  "priority": "high",
  "type": "library",
  "build": {
