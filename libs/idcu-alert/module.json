{
  "name": "idcu-alert",
  "category": "library",
  "version": "1.0.0",
  "description": "IDCU Agent 告警模块，提供告警管理和通知功能",
  "author": "IDCU Team",
  "license": "MIT",
  "dependencies": ["idcu-common", "idcu-log", "idcu-metrics"],
  "priority": "normal",
  "type": "library",
  "build": {
    "language": "C",
    "standard": "99",
    "type": "static",
    "sources": ["src/idcu/alert/*.c"],
    "includes": ["include"],
    "link_libraries": ["idcu-common", "idcu-log", "idcu-metrics"],
    "platform_deps": {
      "win32": ["ws2_32"],
      "unix": ["pthread"]
    }
  }
}
