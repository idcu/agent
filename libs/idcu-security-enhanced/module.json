  "version": "1.0.0",
  "description": "IDCU 增强安全组件库，提供加密、哈希、随机数生成等功能",
  "author": "IDCU Team",
  "license": "MIT",
  "dependencies": ["idcu-common", "idcu-log"],
  "priority": "medium",
  "type": "library",
  "build": {
