title IDCU Agent 核心架构图

package "应用层 (App Layer)" {
    [idcu_agent] as app
    [idcu_benchmark] as benchmark
}

package "业务模块层 (Business Modules)" <<business>> {
    [core-module] as bus_core
    [log] as bus_log
    [metrics] as bus_metrics
    [healthcheck] as bus_health
    [alert] as bus_alert
    [collect] as bus_collect
    [storage] as bus_storage
    [cache] as bus_cache
}

package "服务模块层 (Service Modules)" <<services>> {
    [plugin_ecosystem] as svc_plugin
    [security] as svc_security
    [storage] as svc_storage
    [cache] as svc_cache
}

package "核心模块层 (Core Modules)" <<core>> {
    [micro-kernel] as core_kernel
    [module-system] as core_modsys
    [scheduler] as core_sched
    [sdk] as core_sdk
}

package "基础库层 (Base Libraries)" <<libs>> {
    [idcu-common] as lib_common
    [idcu-log] as lib_log
    [idcu-network] as lib_net
    [idcu-msgbus] as lib_msgbus
    [idcu-coroutine] as lib_coro
    [idcu-memory] as lib_mem
    [idcu-metrics] as lib_metrics
    [idcu-json] as lib_json
    [idcu-config] as lib_cfg
}

' 连接关系
app --> bus_core
app --> bus_log
app --> bus_metrics
app --> bus_health

bus_core --> core_kernel
bus_core --> core_sdk
bus_log --> lib_log
bus_metrics --> lib_metrics
bus_health --> svc_security
bus_alert --> lib_common
bus_collect --> lib_net
bus_storage --> svc_storage
bus_cache --> svc_cache

svc_plugin --> core_modsys
svc_security --> lib_common
svc_storage --> lib_common
svc_cache --> lib_common

core_kernel --> core_sched
core_kernel --> core_modsys
core_sched --> lib_coro
core_sched --> lib_msgbus
core_modsys --> lib_common
core_sdk --> lib_common

lib_log --> lib_common
lib_net --> lib_common
lib_msgbus --> lib_common
lib_coro --> lib_common
lib_mem --> lib_common
lib_metrics --> lib_common
lib_json --> lib_common
lib_cfg --> lib_common

@enduml

@startuml Module Communication Sequence

skinparam backgroundColor #FEFEFE
skinparam handwritten false
skinparam shadowing false
skinparam linetype ortho
skinparam defaultFontName "Monospace"

title 模块通信时序图

actor User as user
participant "Application" as app
participant "Core Module" as bus_core
participant "Micro Kernel" as kernel
participant "Module System" as modsys
participant "Business Module" as biz_mod
participant "Message Bus" as msgbus
database "Storage" as storage

== 模块加载阶段 ==

user -> app: 启动应用
app -> bus_core: 初始化核心模块
bus_core -> kernel: micro_kernel_init()
kernel -> modsys: module_manager_init()
modsys -> modsys: 扫描模块目录
modsys -> modsys: 加载模块依赖
modsys -> biz_mod: module_init()
biz_mod --> modsys: 返回状态
modsys --> kernel: 模块加载完成
kernel --> bus_core: 内核就绪
bus_core --> app: 初始化完成

== 模块通信阶段 ==

user -> app: 发送业务请求
app -> bus_core: dispatch_request()
bus_core -> kernel: send_message()
kernel -> msgbus: msg_bus_publish()
msgbus -> msgbus: 路由消息
msgbus -> biz_mod: module_on_message()
biz_mod -> biz_mod: 处理业务逻辑
biz_mod -> storage: 读写数据
storage --> biz_mod: 返回数据
biz_mod -> msgbus: 发送响应消息
msgbus -> kernel: 传递响应
kernel -> bus_core: 接收响应
bus_core --> app: 返回结果
app --> user: 展示响应

== 模块卸载阶段 ==

user -> app: 停止应用
app -> bus_core: shutdown()
bus_core -> kernel: micro_kernel_shutdown()
kernel -> modsys: module_manager_shutdown()
modsys -> biz_mod: module_cleanup()
biz_mod --> modsys: 清理完成
modsys -> modsys: 卸载模块
modsys --> kernel: 完成
kernel --> bus_core: 内核关闭
bus_core --> app: 清理完成

@enduml

@startuml Coroutine Scheduler

skinparam backgroundColor #FEFEFE
skinparam handwritten false
skinparam shadowing false
skinparam linetype ortho
skinparam defaultFontName "Monospace"

title 协程调度器架构

package "协程调度器" {
    [Scheduler] as sched
    [Coroutine Pool] as pool
    [Context Manager] as ctx
    [Message Queue] as mq
}

package "协程实例" {
    [Coroutine 1] as co1
    [Coroutine 2] as co2
    [Coroutine 3] as co3
    [Coroutine N] as con
}

package "底层支持" {
    [Context Switch] as switch
    [Timer] as timer
    [Event Loop] as loop
}

sched --> pool
pool --> co1
pool --> co2
pool --> co3
pool --> con

sched --> ctx
ctx --> switch

sched --> mq

sched --> loop
loop --> timer

@enduml
